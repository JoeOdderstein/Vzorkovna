# Supabase (public — safe for browser)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Taskboard auth (server only — do NOT prefix with VITE_)
TASKBOARD_USERNAME=vzorkovna
TASKBOARD_PASSWORD=your-secure-password
# Optional extra logins (same shared taskboard): _2, _3, … up to _10
TASKBOARD_USERNAME_2=admin
TASKBOARD_PASSWORD_2=your-second-password
# Optional: username that can manage all projects and visibility (default: admin)
TASKBOARD_ADMIN_USERNAME=admin
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
# Server-only — for assignment emails (Settings → API → service_role key)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend assignment notifications (server only)
RESEND_API_KEY=re_your_api_key
EMAIL_FROM=taskboard@yourdomain.com
TASKBOARD_SITE_URL=https://your-site.com
# Optional: timezone for Google Calendar links in assignment emails
CALENDAR_TIMEZONE=Europe/Amsterdam

# Optional: fixed UUID for shared taskboard user JWT subject
TASKBOARD_USER_ID=00000000-0000-0000-0000-000000000001
